---
import type { ComponentProps } from 'astro/types';
import FooterLinks from '../theme/FooterLinks.astro';

const props = Astro.props as ComponentProps<typeof FooterLinks>;
---

<div class="@container grow max-w-4xl">
  <div class="grid grid-cols-1 gap-8 @sm:grid-cols-2 @xl:grid-cols-3 @2xl:grid-cols-4">
    <FooterLinks {...props} />
  </div>
</div>
