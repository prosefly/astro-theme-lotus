---
import Code from 'astro/components/Code.astro';

type CodeTheme = string | Record<string, unknown>;
type CodeThemes = Record<string, CodeTheme>;

interface Props {
  code: string;
  lang?: string;
  title?: string;
  class?: string;
  trim?: boolean;
  theme?: CodeTheme;
  themes?: CodeThemes;
}

const {
  code,
  lang,
  title,
  class: className,
  trim,
  theme,
  themes = {
    light: 'github-light',
    dark: 'github-dark',
  },
} = Astro.props;

const highlightedCode = trim ? code.trim() : code;
---

<figure class:list={['lotus-code-block', title && 'lotus-code-block--framed', className]}>
  {title && <figcaption class="lotus-code-block__header">{title}</figcaption>}
  <div class="lotus-code-block__body">
    <Code
      code={highlightedCode}
      lang={lang as never}
      theme={theme as never}
      themes={theme ? undefined : themes as never}
    />
  </div>
</figure>

<style is:global>
  .lotus-code-block {
    background: var(--lotus-code-background);
    border: 1px solid var(--lotus-code-border);
    border-radius: min(var(--lotus-radius-lg), 1rem);
    color: var(--lotus-text);
    margin: 0;
    max-width: 100%;
    overflow: hidden;
  }

  .lotus-code-block__header {
    align-items: center;
    background: var(--lotus-code-surface);
    border-block-end: 1px solid var(--lotus-code-border);
    block-size: var(--lotus-code-header-height);
    box-sizing: border-box;
    color: var(--lotus-text-muted);
    display: flex;
    font-family: var(--lotus-font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.25rem;
    min-block-size: var(--lotus-code-header-height);
    margin: 0;
    padding-block: 0;
    padding-inline: 1rem;
  }

  .lotus-code-block__body {
    background: var(--lotus-code-background);
    max-width: 100%;
    overflow-x: auto;
  }

  .lotus-code-block__body > pre {
    border: none;
    border-radius: 0;
  }

  .lotus-code-block .astro-code {
    background: transparent !important;
    color: var(--lotus-text);
    font-family: var(--lotus-font-mono);
    font-feature-settings: var(--default-mono-font-feature-settings);
    font-size: 0.875rem;
    line-height: 1.7142857;
    margin: 0;
    overflow: visible;
    padding: 0.8571429rem 1rem;
  }

  .lotus-code-block .astro-code code {
    display: block;
    min-width: max-content;
  }

  :root[data-theme="dark"] .lotus-code-block .astro-code,
  :root[data-theme="dark"] .lotus-code-block .astro-code span {
    color: var(--shiki-dark) !important;
    font-style: var(--shiki-dark-font-style) !important;
    font-weight: var(--shiki-dark-font-weight) !important;
    text-decoration: var(--shiki-dark-text-decoration) !important;
  }

  @media (prefers-color-scheme: dark) {
    :root[data-theme="system"] .lotus-code-block .astro-code,
    :root[data-theme="system"] .lotus-code-block .astro-code span {
      color: var(--shiki-dark) !important;
      font-style: var(--shiki-dark-font-style) !important;
      font-weight: var(--shiki-dark-font-weight) !important;
      text-decoration: var(--shiki-dark-text-decoration) !important;
    }
  }
</style>
