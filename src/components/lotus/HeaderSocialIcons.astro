---
import type { ComponentProps } from 'astro/types';
import {
  AppearancePalette,
  SocialIcons,
} from '@prosefly/astro-theme-lotus/components';

const props = Astro.props as ComponentProps<typeof SocialIcons>;
---

<SocialIcons {...props} />
<span class="hidden lg:inline-block">
  <AppearancePalette />
</span>
